{
  "name": "github-metrics-streamdeck-plugin",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Plugin de Stream Deck com métricas gerais da conta GitHub do usuário, coletadas via gh CLI local.",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart dev.tferrer.githubmetrics\"",
    "validate": "streamdeck validate dev.tferrer.githubmetrics.sdPlugin",
    "pack": "streamdeck pack dev.tferrer.githubmetrics.sdPlugin",
    "test": "vitest run"
  },
  "devDependencies": {
    "@elgato/cli": "^1.8.1",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/node": "^22.20.1",
    "rollup": "^4.24.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2"
  }
}
