{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.tiagoferrer.githubmetrics",
  "Name": "GitHub Metrics",
  "Version": "0.1.0.0",
  "Author": "Tiago Ferrer",
  "Description": "Métricas gerais da sua conta GitHub — PRs, issues, notificações, commits, reviews e estrelas — coletadas via GitHub CLI (gh) local. Não monitora um repositório específico.",
  "Category": "GitHub Metrics",
  "CategoryIcon": "imgs/category/category",
  "Icon": "imgs/plugin/icon",
  "CodePath": "bin/plugin.js",
  "PropertyInspectorPath": "ui/simple-metric.html",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24",
    "Debug": "enabled"
  },
  "Actions": [
    {
      "UUID": "com.tiagoferrer.githubmetrics.prs-open",
      "Name": "PRs Abertas",
      "Tooltip": "Quantidade de Pull Requests abertas por você",
      "Icon": "imgs/actions/prs-open/icon",
      "PropertyInspectorPath": "ui/simple-metric.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/prs-open/icon",
          "TitleAlignment": "bottom",
          "FontSize": 16
        }
      ]
    },
    {
      "UUID": "com.tiagoferrer.githubmetrics.review-requested",
      "Name": "Review Solicitada",
      "Tooltip": "PRs aguardando sua review",
      "Icon": "imgs/actions/review-requested/icon",
      "PropertyInspectorPath": "ui/simple-metric.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/review-requested/icon",
          "TitleAlignment": "bottom",
          "FontSize": 16
        }
      ]
    },
    {
      "UUID": "com.tiagoferrer.githubmetrics.issues-assigned",
      "Name": "Issues Atribuídas",
      "Tooltip": "Issues abertas atribuídas a você",
      "Icon": "imgs/actions/issues-assigned/icon",
      "PropertyInspectorPath": "ui/simple-metric.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/issues-assigned/icon",
          "TitleAlignment": "bottom",
          "FontSize": 16
        }
      ]
    },
    {
      "UUID": "com.tiagoferrer.githubmetrics.notifications",
      "Name": "Notificações",
      "Tooltip": "Notificações não lidas",
      "Icon": "imgs/actions/notifications/icon",
      "PropertyInspectorPath": "ui/simple-metric.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/notifications/icon",
          "TitleAlignment": "bottom",
          "FontSize": 16
        }
      ]
    },
    {
      "UUID": "com.tiagoferrer.githubmetrics.commits",
      "Name": "Commits",
      "Tooltip": "Commits contribuídos no período selecionado",
      "Icon": "imgs/actions/commits/icon",
      "PropertyInspectorPath": "ui/period-metric.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/commits/icon",
          "TitleAlignment": "bottom",
          "FontSize": 14
        }
      ]
    },
    {
      "UUID": "com.tiagoferrer.githubmetrics.reviews-done",
      "Name": "Reviews Feitas",
      "Tooltip": "Reviews de PR realizadas no período selecionado",
      "Icon": "imgs/actions/reviews-done/icon",
      "PropertyInspectorPath": "ui/period-metric.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/reviews-done/icon",
          "TitleAlignment": "bottom",
          "FontSize": 14
        }
      ]
    },
    {
      "UUID": "com.tiagoferrer.githubmetrics.stars-received",
      "Name": "Estrelas Recebidas",
      "Tooltip": "Total de estrelas nos seus repositórios",
      "Icon": "imgs/actions/stars-received/icon",
      "PropertyInspectorPath": "ui/simple-metric.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/stars-received/icon",
          "TitleAlignment": "bottom",
          "FontSize": 16
        }
      ]
    },
    {
      "UUID": "com.tiagoferrer.githubmetrics.status",
      "Name": "Status da Conta",
      "Tooltip": "Diagnóstico: autenticação do gh e rate limit da API",
      "Icon": "imgs/actions/status/icon",
      "PropertyInspectorPath": "ui/status.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/status/ok",
          "Name": "OK",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/status/error",
          "Name": "Erro",
          "TitleAlignment": "bottom"
        }
      ]
    }
  ]
}