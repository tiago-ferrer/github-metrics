{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "dev.tferrer.githubmetrics",
  "Name": "GitHub Metrics",
  "Version": "0.4.0.0",
  "Author": "Tiago Ferrer",
  "Description": "Métricas gerais da sua conta GitHub — PRs, issues, notificações, commits, reviews e estrelas — coletadas via GitHub CLI (gh) local. Não monitora um repositório específico.",
  "Category": "GitHub Metrics",
  "CategoryIcon": "imgs/category/category",
  "Icon": "imgs/plugin/icon",
  "CodePath": "bin/plugin.js",
  "PropertyInspectorPath": "ui/simple-metric.html",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24",
    "Debug": "enabled"
  },
  "Actions": [
    {
      "UUID": "dev.tferrer.githubmetrics.prs-open",
      "Name": "PRs Abertas",
      "Tooltip": "PRs que você abriu no período selecionado e que ainda seguem abertas (opcionalmente restrita a uma organização)",
      "Icon": "imgs/actions/prs-open/icon",
      "PropertyInspectorPath": "ui/period-metric.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/prs-open/icon"
        }
      ]
    },
    {
      "UUID": "dev.tferrer.githubmetrics.review-requested",
      "Name": "Review Solicitada",
      "Tooltip": "PRs aguardando sua review (opcionalmente restrita a uma organização)",
      "Icon": "imgs/actions/review-requested/icon",
      "PropertyInspectorPath": "ui/simple-metric-org.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/review-requested/icon"
        }
      ]
    },
    {
      "UUID": "dev.tferrer.githubmetrics.issues-assigned",
      "Name": "Issues Atribuídas",
      "Tooltip": "Issues abertas atribuídas a você (opcionalmente restrita a uma organização)",
      "Icon": "imgs/actions/issues-assigned/icon",
      "PropertyInspectorPath": "ui/simple-metric-org.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/issues-assigned/icon"
        }
      ]
    },
    {
      "UUID": "dev.tferrer.githubmetrics.notifications",
      "Name": "Notificações",
      "Tooltip": "Notificações não lidas (opcionalmente restrita a uma organização)",
      "Icon": "imgs/actions/notifications/icon",
      "PropertyInspectorPath": "ui/simple-metric-org.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/notifications/icon"
        }
      ]
    },
    {
      "UUID": "dev.tferrer.githubmetrics.commits",
      "Name": "Commits",
      "Tooltip": "Commits contribuídos no período selecionado (opcionalmente restrito a uma organização)",
      "Icon": "imgs/actions/commits/icon",
      "PropertyInspectorPath": "ui/period-metric.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/commits/icon"
        }
      ]
    },
    {
      "UUID": "dev.tferrer.githubmetrics.reviews-done",
      "Name": "Reviews Feitas",
      "Tooltip": "Reviews de PR realizadas no período selecionado (opcionalmente restrito a uma organização)",
      "Icon": "imgs/actions/reviews-done/icon",
      "PropertyInspectorPath": "ui/period-metric.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/reviews-done/icon"
        }
      ]
    },
    {
      "UUID": "dev.tferrer.githubmetrics.stars-received",
      "Name": "Estrelas Recebidas",
      "Tooltip": "Total de estrelas nos seus repositórios",
      "Icon": "imgs/actions/stars-received/icon",
      "PropertyInspectorPath": "ui/simple-metric.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/stars-received/icon"
        }
      ]
    },
    {
      "UUID": "dev.tferrer.githubmetrics.org-prs-open",
      "Name": "PRs Project",
      "Tooltip": "PRs abertas de um repositório específico (de qualquer autor), organização opcional",
      "Icon": "imgs/actions/prs-project/icon",
      "PropertyInspectorPath": "ui/prs-project.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/prs-project/icon"
        }
      ]
    },
    {
      "UUID": "dev.tferrer.githubmetrics.pushes",
      "Name": "Pushes",
      "Tooltip": "Pushes feitos no período selecionado (opcionalmente restrito a uma organização) — cobre só os últimos ~90 dias, limitação da API de eventos do GitHub",
      "Icon": "imgs/actions/pushes/icon",
      "PropertyInspectorPath": "ui/period-metric-90d.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/pushes/icon"
        }
      ]
    },
    {
      "UUID": "dev.tferrer.githubmetrics.pr-comments",
      "Name": "PR Comments",
      "Tooltip": "Comentários feitos na conversa de Pull Requests no período selecionado (opcionalmente restrito a uma organização) — cobre só os últimos ~90 dias, limitação da API de eventos do GitHub",
      "Icon": "imgs/actions/pr-comments/icon",
      "PropertyInspectorPath": "ui/period-metric-90d.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/pr-comments/icon"
        }
      ]
    },
    {
      "UUID": "dev.tferrer.githubmetrics.inline-comments",
      "Name": "Inline Comments",
      "Tooltip": "Comentários em linhas do diff de Pull Requests no período selecionado (opcionalmente restrito a uma organização) — cobre só os últimos ~90 dias, limitação da API de eventos do GitHub",
      "Icon": "imgs/actions/inline-comments/icon",
      "PropertyInspectorPath": "ui/period-metric-90d.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/inline-comments/icon"
        }
      ]
    },
    {
      "UUID": "dev.tferrer.githubmetrics.status",
      "Name": "Status da Conta",
      "Tooltip": "Diagnóstico: autenticação do gh e rate limit da API",
      "Icon": "imgs/actions/status/icon",
      "PropertyInspectorPath": "ui/status.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/status/ok",
          "Name": "OK"
        },
        {
          "Image": "imgs/actions/status/error",
          "Name": "Erro"
        }
      ]
    }
  ]
}
